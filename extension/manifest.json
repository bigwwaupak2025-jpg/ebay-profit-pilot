{
  "manifest_version": 3,
  "name": "eBay Profit Pilot",
  "version": "1.0.0",
  "description": "Read a supplier product page, find the same product on eBay Australia, and get the price that leaves your minimum profit after eBay fees and postage.",
  "action": { "default_title": "Open eBay Profit Pilot", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" } },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "activeTab", "scripting", "tabs", "storage"],
  "host_permissions": [
    "https://*.aliexpress.com/*", "https://*.aliexpress.us/*", "https://*.temu.com/*", "https://*.alibaba.com/*",
    "https://*.cjdropshipping.com/*", "https://*.dhgate.com/*", "https://*.amazon.com.au/*",
    "https://www.ebay.com.au/*", "https://api.anthropic.com/*"
  ]
}
